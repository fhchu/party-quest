# ADDR and AUTO_MIGRATE show their defaults (internal/config/config.go).
# The database file is created if missing; .gitignore keeps it out of git.
DATABASE_PATH=game.db
# The secret the game server sends to POST /runs. Any long random string;
# the game server must send the same one.
GAME_SERVER_TOKEN=dev-game-server-token
ADDR=:8080
AUTO_MIGRATE=true
# START_MARKER is set only in the container (deploy/compose.yaml): locally,
# the file would outlive each run and every start would read as a restart.
