{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "SubagentHandback",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/reviewed-on-handback.py",
						"timeout": 10
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/before-bash.py",
						"statusMessage": "Checking the command against the repo rules"
					}
				]
			}
		]
	}
}
