{
	"party-quest": {
		"PreToolUse": [
			{
				"matcher": "^run_command$",
				"hooks": [
					{
						"type": "command",
						"command": "python3 .agents/hooks/before-bash.py",
						"timeout": 600
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": ".agents/bin/worktree.sh include >&2 && echo '{}'",
						"timeout": 120
					}
				]
			}
		]
	}
}
