.env
.env.*
!.env.example

# Keys and certificates: never committed (SSH keys, TLS keys, AWS keys).
*.pem
*.key
*.ppk
*.p12
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts
.aws/
*.out
/server/bin/
# The backend's local SQLite database (server/.env.example), with its WAL
# files.
/server/*.db
/server/*.db-*
# `go build` in relay/ writes its binary here.
/relay/relay
/deploy/web/
# Secrets for deploy/deploy.sh (deploy/secrets.env.example).
/deploy/secrets.env

# Godot (game/)
.godot/
/game/build/
# Written and deleted by check.sh's warnings check.
/game/override.cfg

# macOS
.DS_Store
/deploy/web-template/out/
