.env
.env.*
!.env.example

# Keys and certificates: never committed (SSH keys, TLS keys, AWS keys).
*.pem
*.key
*.ppk
*.p12
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts
.aws/
*.out
/backend/bin/
# The backend's local SQLite database (backend/.env.example), with its WAL
# files.
/backend/*.db
/backend/*.db-*
# `go build` in relay/ writes its binary here.
/relay/relay
/deploy/web/
# Secrets for deploy/deploy.sh (deploy/secrets.env.example).
/deploy/secrets.env

# Godot (game/)
.godot/
/game/build/
# Written and deleted by check.sh's warnings check.
/game/override.cfg

# macOS
.DS_Store
/deploy/web-template/out/

# Art images are kept out of the public repo; copy them into the main
# checkout by hand, and .worktreeinclude copies them into worktrees. The
# tile sets beside them only point at them, so they're tracked. PNGs
# already tracked (the test addon's) stay tracked.
*.png
*.png.import
