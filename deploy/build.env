# Values the builds, deploys and CI read. Shell scripts source it; the
# workflows add its NAME=value lines to their environment, so values have
# no quotes or spaces. Copies that can't read it are checked against it by
# check.sh (check_sync).

# The Godot the workflows install and the game image runs.
GODOT_VERSION=4.7.2
# The Go image both Dockerfiles build in.
GO_VERSION=1.27.4

# Tagged with the version by deploy/deploy.sh and the release workflow.
GAME_IMAGE=ghcr.io/fhchu/party-quest
BACKEND_IMAGE=ghcr.io/fhchu/party-quest-backend

# The secrets deploy/up.sh sends to the server, comma-separated.
SECRET_NAMES=GAME_SERVER_TOKEN,GRAFANA_LOGS_URL,GRAFANA_LOGS_USER,GRAFANA_LOGS_TOKEN

# The public name of the game. Its A record must point at the instance before
# the first deploy: the relay asks Let's Encrypt for a certificate for it.
# deploy/up.sh writes it into the server's .env.
DOMAIN=lelize.com
