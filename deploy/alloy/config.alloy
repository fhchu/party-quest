// Ships every container's logs on the instance to Grafana Cloud, labelled
// by Compose service. Run by the alloy service in deploy/compose.yaml; the
// alert rules that read these logs are in deploy/grafana/alerts.json.

// Both hosts must match the socket mount in deploy/compose.yaml.
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = []

	// The alert rules select by this label.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.containers.targets
	relabel_rules = discovery.relabel.containers.rules
	forward_to    = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_LOGS_URL")

		basic_auth {
			username = sys.env("GRAFANA_LOGS_USER")
			password = sys.env("GRAFANA_LOGS_TOKEN")
		}
	}
}
