# Copy to deploy/secrets.env (git-ignored) for deploy/deploy.sh. Releases
# read the same names from the production environment's secrets on GitHub.
# The backend requires it on POST /runs. Any long random string of letters
# and digits (Compose reads a $ as a variable).
GAME_SERVER_TOKEN=
# Grafana Cloud's logs endpoint (its Loki push URL, ending /loki/api/v1/push),
# its user number, and an access policy token that can write logs.
GRAFANA_LOGS_URL=
GRAFANA_LOGS_USER=
GRAFANA_LOGS_TOKEN=
